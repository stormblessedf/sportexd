{
  "name": "sporsal-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Sporsal",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "loadtest:seed": "node scripts/loadtest_seed.js",
    "loadtest:verify": "node scripts/loadtest_verify_chat_summaries.js",
    "loadtest:cleanup": "node scripts/loadtest_cleanup.js",
    "loadtest:cleanup:dry": "node scripts/loadtest_cleanup.js --dryRun"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "typescript": "^5.0.0"
  },
  "private": true
}
